ARG NODE_VERSION=22.15.0
ARG PNPM_VERSION=10.11.0

# Use Node.js slim (Debian) as base image — Alpine musl blocks pnpm 10 onlyBuiltDependencies
FROM node:${NODE_VERSION}-slim

ARG PNPM_VERSION

RUN apt-get update -q && apt-get install -y --no-install-recommends curl postgresql-client rclone && rm -rf /var/lib/apt/lists/*
# Install pnpm globally
RUN npm install -g pnpm@${PNPM_VERSION}

# Set working directory
WORKDIR /app

# Copy package files
COPY package.json pnpm-lock.yaml ./


# Install dependencies
RUN pnpm config set store-dir /pnpm/store
RUN --mount=type=cache,id=pnpm-v2,target=/pnpm/store pnpm install --frozen-lockfile

# Copy source code
COPY . .

# Expose port
EXPOSE 8000

# Start the application in development mode
CMD ["pnpm", "run", "start:dev"]
