PORT=3000

# Database
DATABASE_URL=postgres://postgres:postgres@docxtractor-db:5432/docxtractor

# Redis
REDIS_URL=redis://redis:6380
REDIS_HOST=redis
REDIS_PORT=6380

# Mail (Brevo SMTP)
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-brevo-email@example.com
MAIL_PASS=your-brevo-smtp-key

# Google OAuth
GOOGLE_CLIENT_ID=placeholder_client_id
GOOGLE_CLIENT_SECRET=placeholder_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# JWT Tokens
JWT_ACCESS_SECRET=placeholder_access_secret
JWT_REFRESH_SECRET=placeholder_refresh_secret
JWT_RESET_SECRET=placeholder_reset_secret

# Swagger
SWAGGER_USER=admin
SWAGGER_PASS=admin

# Throttler
THROTTLER_TTL=60000
THROTTLER_LIMIT=100

# MinIO
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_PUBLIC_URL=http://localhost:9000

# Ollama
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_DEFAULT_MODEL=qwen3:14b
OLLAMA_GENERATION_MODEL=qwen3:14b

# Extraction Service APIs
GOOGLE_API_KEY=
LANGEXTRACT_API_KEY=

# Pusher
PUSHER_APP_ID=123456
PUSHER_KEY=0123456789abcdef0123
PUSHER_SECRET=0123456789abcdef0123
PUSHER_CLUSTER=ap2

# Web Push (VAPID)
VAPID_EMAIL=admin@example.com
VAPID_PUBLIC_KEY=placeholder_public_key
VAPID_PRIVATE_KEY=placeholder_private_key

# Twilio
TWILIO_ACCOUNT_SID=AC_placeholder_sid
TWILIO_AUTH_TOKEN=placeholder_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# AI
AZURE_OPENAI_API_KEY=placeholder_azure_key
