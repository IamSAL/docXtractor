PORT=3000

# Database
DATABASE_URL=postgres://postgres:postgres@docxtractor-db:5432/docxtractor

# Redis
REDIS_URL=redis://redis:6380
REDIS_HOST=redis
REDIS_PORT=6380

# JWT Tokens (required — change these for production!)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_RESET_SECRET=change-me-reset-secret

# MinIO
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Ollama
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_DEFAULT_MODEL=qwen3:14b
OLLAMA_GENERATION_MODEL=qwen3:14b

# Extraction Service APIs (set GOOGLE_API_KEY if using Gemini extraction provider)
# GOOGLE_API_KEY=
# LANGEXTRACT_API_KEY=

# Swagger (optional — defaults to admin/admin)
# SWAGGER_USER=admin
# SWAGGER_PASS=admin

# Frontend URL (for magic links and invite emails)
# FRONTEND_URL=http://localhost:5174

# --- SMTP & Google OAuth are configured in the admin UI (Settings > Instance) ---
# No env vars needed for mail or OAuth. Configure them after first-run setup.
